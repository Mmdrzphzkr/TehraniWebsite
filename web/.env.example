# Example environment variables for local development

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS (Strapi v5)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=39f84041df8fd07cb1e85aa3a700587df055f540b3acfbd4ff7e38d1f1e9678f197154b51e09869b1e93258bc87845b86509916faefd5df8a49d2e3cc6fd9ee9f5ceef03cc444cadf661a8f853836cc1eb4451da3e6744b3708d9af11e5939871faf9ae1ecba2c1ece6ccf27cc72212b320c8d95ace8e7acd94eb1713c117323

# Database (Postgres) used by backend / Strapi
DATABASE_URL=postgresql://postgres:password@localhost:5432/tehrani

# SMS Provider (FarazSMS) - Optional
FARAZ_SMS_USERNAME=your-farazsms-username
FARAZ_SMS_PASSWORD=your-farazsms-password
FARAZ_SMS_PATTERN_ID=your-pattern-id

# JWT / Auth
JWT_SECRET=change_this_to_a_strong_secret_min_32_chars
JWT_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=3

# Encryption (for national IDs)
ENCRYPTION_KEY=your-32-char-hex-key-here-min-32
ENCRYPTION_IV=your-16-char-hex-iv-here-min-16

# Email Service (Optional)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@example.com
